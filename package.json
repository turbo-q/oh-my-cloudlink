{
  "name": "oh-my-cloudlink",
  "productName": "Oh My CloudLink",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "node scripts/kill-stale-electron.mjs && npm run build:electron && concurrently -k \"npm run build:electron:watch\" \"npm run dev:electron:run\"",
    "dev:electron:run": "wait-on http://localhost:5173 dist-electron/main.js dist-electron/preload.js && nodemon --watch dist-electron/main.js --watch dist-electron/preload.js --delay 500ms --exec \"env -u ELECTRON_RUN_AS_NODE electron .\"",
    "build:electron:watch": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "build:native-term": "npm --prefix native-term install && npm --prefix native-term run build:electron",
    "build": "npm run build:electron && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "icons": "bash scripts/generate-icons.sh",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.17.0",
    "uuid": "^14.0.2",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.ohmycloudlink.ssh",
    "productName": "Oh My CloudLink",
    "executableName": "oh-my-cloudlink",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "name": "oh-my-cloudlink"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Install Oh My CloudLink",
      "iconSize": 100,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "OhMyCloudLink-${version}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
